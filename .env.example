[TEMPLATE]
# VeriFYI backend environment variables (copy to .env.local — never commit it)

# --- AI provider selection -------------------------------------------------
# gemini (default, active) | mock (dev/demo, no credentials needed) | bedrock
AI_PROVIDER=gemini

# Google Gemini (server-side only — the key must NEVER reach the client).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model. Default: gemini-2.5-flash (verified live).
# Note: the "gemini-flash-latest" alias may temporarily return 503 when the
# model it points to is newly shipped and overloaded.
GEMINI_MODEL=

# Legacy dev flag, still honored: AI_PROVIDER=mock (kept for compatibility)
MOCK_BEDROCK=

# --- AWS (Bedrock kept as a future provider; DynamoDB history optional) ----
# AWS region for Bedrock/DynamoDB (credentials come from the default chain:
# `aws login` SSO locally, the Lambda role in production)
AWS_REGION=us-east-1

# Bedrock model ID (cross-region inference profile). Leave empty to use the
# default: us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=

# DynamoDB table for verification history (optional; history is disabled if unset)
VERIFICATIONS_TABLE_NAME=

# S3 bucket for optional document uploads (P1; disabled if unset)
UPLOADS_BUCKET_NAME=

# --- Frontend (J Bob's UI, now integrated in this app) ----------------------
# false -> UI calls this app's /api/analyze for real; true/unset -> canned UI demo
NEXT_PUBLIC_USE_MOCK=false
# Base URL the UI calls for analyses (same app serves both UI and API).
NEXT_PUBLIC_API_URL=
